{{> head}}
<body class="bg-gray-50">
  <div class="min-h-screen">
    <!-- Header -->
    <header class="bg-white shadow-sm border-b border-gray-200">
  <div class="w-full px-4 sm:px-6 lg:px-8">
  <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 flex items-center justify-center">
                <img src="/logo.png" alt="MINSU Logo" class="w-10 h-10 object-cover rounded-lg" />
              </div>
              <div>
                <h1 class="text-xl font-bold text-gray-900">CollegeTrack</h1>
                <p class="text-sm text-gray-600">Students</p>
              </div>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <div class="text-right">
              <div class="text-sm font-medium text-gray-900">{{ userName }}</div>
              <div class="text-sm text-gray-600">{{ userRole }}</div>
            </div>
            <a href="/logout" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium">Logout</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Nav -->
    <nav class="bg-white shadow-sm">
      <div class="w-full px-4 sm:px-6 lg:px-8">
        <div class="flex space-x-8">
          <a href="/admin-dashboard" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Dashboard</a>
          <a href="/checkinout" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Check In/Out</a>
          <a href="/history" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">History</a>
          <a href="/students" class="bg-green-600 text-white px-4 py-2 rounded-md text-sm font-medium">Students</a>
          <a href="/calendar" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Calendar</a>
          <a href="/subjects" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Subjects</a>
        </div>
      </div>
    </nav>

    <main class="w-full px-4 py-6 sm:px-6 lg:px-8">
      <div class="px-4 py-6 sm:px-0">
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6 mb-6">
          <div class="flex justify-between items-center mb-4">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">Student Management</h3>
              <p class="text-sm text-gray-600">Manage college student information and enrollment</p>
            </div>
            <div>
              <a href="/register" class="bg-green-600 text-white px-4 py-2 rounded-md text-sm font-medium">+ Add Student</a>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="studentsGrid">
            <!-- Student cards injected here -->
          </div>
        </div>
      </div>
    </main>

    <script>
      async function fetchStudents() {
        try {
          const res = await fetch('/api/students');
          if (!res.ok) throw new Error('Network response was not ok');
          const json = await res.json();
          renderStudents(json.data || []);
        } catch (err) {
          console.error('Error fetching students:', err);
        }
      }

      function renderStudents(students) {
        const grid = document.getElementById('studentsGrid');
        grid.innerHTML = '';
        students.forEach(s => {
          const card = document.createElement('div');
          card.className = 'bg-white rounded-lg border border-gray-200 p-4';
          card.setAttribute('data-student-id', String(s.id));
          card.innerHTML = `
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                <span id="student-initials-${s.id}" class="text-green-600 font-semibold">${escapeHtml(getInitials(s.fullName))}</span>
              </div>
              <div class="flex-1">
                <div class="flex justify-between items-start">
                  <div>
                    <div id="student-fullname-${s.id}" class="font-semibold text-gray-900">${escapeHtml(s.fullName)}</div>
                    <div id="student-course-${s.id}" class="text-sm text-gray-500">${escapeHtml(s.course)}</div>
                    <div id="student-id-${s.id}" class="text-sm text-gray-400">${escapeHtml(s.studentId)}</div>
                  </div>
                  <div class="text-right">
                    <div id="student-year-${s.id}" class="text-sm text-gray-500">${escapeHtml(s.year)} Year</div>
                    <div class="mt-2 inline-block bg-green-600 text-white px-3 py-1 rounded-full text-sm">Active</div>
                  </div>
                </div>
                <div class="mt-4 text-sm text-gray-600">
                  <div id="student-course-dup-${s.id}">${escapeHtml(s.course)}</div>
                  <div id="student-email-${s.id}" class="mt-2">${escapeHtml(s.email)}</div>
                  <div class="mt-2 text-sm text-gray-400">-</div>
                  <div class="mt-2 text-sm text-gray-400">Last seen just now</div>
                </div>
                <!-- action buttons: Edit / Delete -->
                <div class="mt-4 flex space-x-2">
                  <button data-student-id="${escapeHtml(s.id)}" class="editStudentBtn bg-blue-50 text-blue-700 px-3 py-1 rounded text-sm border">Edit</button>
                  <button data-student-id="${escapeHtml(s.id)}" class="deleteStudentBtn bg-red-50 text-red-700 px-3 py-1 rounded text-sm border">Delete</button>
                </div>
              </div>
            </div>
          `;
          grid.appendChild(card);
        });
      }

      function escapeHtml(unsafe) {
        if (!unsafe && unsafe !== 0) return '';
        return String(unsafe)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function getInitials(name) {
        if (!name) return '';
        return name.split(' ').map(n => n.charAt(0)).slice(0,2).join('').toUpperCase();
      }

      // Initial load and polling every 20 seconds for live updates
      document.addEventListener('DOMContentLoaded', () => {
        fetchStudents();
        setInterval(fetchStudents, 20000);
      });
      // Edit/Delete handlers
      document.addEventListener('click', async (e) => {
        if (!e.target) return;
        // Edit button
        if (e.target.classList && e.target.classList.contains('editStudentBtn')) {
          const id = e.target.getAttribute('data-student-id');
          openEditModal(id);
        }

        // Delete button
        if (e.target.classList && e.target.classList.contains('deleteStudentBtn')) {
          const id = e.target.getAttribute('data-student-id');
          if (!confirm('Delete this student? This action cannot be undone.')) return;
          try {
            const res = await fetch(`/api/students/${id}`, { method: 'DELETE' });
            if (!res.ok) throw new Error('Delete failed');
            // remove card from DOM if present
            const card = document.querySelector(`[data-student-id="${id}"]`);
            if (card && card.parentElement) card.parentElement.removeChild(card);
            alert('Student deleted');
          } catch (err) {
            console.error('Delete student error', err);
            alert('Failed to delete student');
          }
        }
      });

      // --- Edit modal implementation ---
      function openEditModal(id) {
        // Find student data from last loaded DOM
        const grid = document.getElementById('studentsGrid');
        // fetch the student details from API to ensure latest
        fetch(`/api/students`).then(r => r.json()).then(json => {
          const s = (json.data || []).find(x => String(x.id) === String(id));
          if (!s) return alert('Student not found');
          showEditModal(s);
        }).catch(err => { console.error(err); alert('Failed to load student'); });
      }

      function showEditModal(s) {
        let modal = document.getElementById('editStudentModal');
        if (!modal) {
          modal = document.createElement('div');
          modal.id = 'editStudentModal';
          modal.className = 'fixed inset-0 z-50 flex items-center justify-center p-4 hidden';
          modal.innerHTML = `
            <div class="fixed inset-0 bg-black bg-opacity-40 z-40" data-close="modal"></div>
            <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6 relative z-50">
              <h3 class="text-lg font-semibold mb-4">Edit Student</h3>
              <form id="editStudentForm" class="space-y-3">
                <input type="hidden" name="id" />
                <div>
                  <label class="block text-sm text-gray-600">Full name</label>
                  <input name="fullName" class="w-full border rounded px-3 py-2" />
                </div>
                <div>
                  <label class="block text-sm text-gray-600">Email</label>
                  <input name="email" class="w-full border rounded px-3 py-2" />
                </div>
                <div>
                  <label class="block text-sm text-gray-600">Course</label>
                  <input name="course" class="w-full border rounded px-3 py-2" />
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block text-sm text-gray-600">Year</label>
                    <input name="year" class="w-full border rounded px-3 py-2" />
                  </div>
                  <div>
                    <label class="block text-sm text-gray-600">Section</label>
                    <input name="section" class="w-full border rounded px-3 py-2" />
                  </div>
                </div>
                <div class="flex justify-end space-x-2">
                  <button type="button" data-close="modal" class="px-4 py-2 rounded bg-gray-200">Cancel</button>
                  <button type="submit" class="px-4 py-2 rounded bg-green-600 text-white">Save</button>
                </div>
              </form>
            </div>
          `;
          document.body.appendChild(modal);

          // close handler
          modal.addEventListener('click', (ev) => {
            if (ev.target && ev.target.getAttribute && ev.target.getAttribute('data-close') === 'modal') {
              modal.classList.add('hidden');
            }
          });

          // submit handler
          modal.querySelector('#editStudentForm').addEventListener('submit', async (ev) => {
            ev.preventDefault();
            const form = ev.target;
            const id = form.elements['id'].value;
            const payload = {
              fullName: form.elements['fullName'].value.trim(),
              email: form.elements['email'].value.trim(),
              course: form.elements['course'].value.trim(),
              year: form.elements['year'].value.trim(),
              section: form.elements['section'].value.trim()
            };
            try {
              const res = await fetch(`/api/student/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
              if (!res.ok) throw new Error('Update failed');
              const json = await res.json();
              modal.classList.add('hidden');
              // Update the card in-place to reflect changes without a full reload
              const updated = json.data || {};
              const sid = String(updated.id || id);
              const fullnameEl = document.getElementById(`student-fullname-${sid}`);
              if (fullnameEl) fullnameEl.textContent = updated.fullName || fullnameEl.textContent;
              const courseEl = document.getElementById(`student-course-${sid}`);
              if (courseEl) courseEl.textContent = updated.course || courseEl.textContent;
              const courseDup = document.getElementById(`student-course-dup-${sid}`);
              if (courseDup) courseDup.textContent = updated.course || courseDup.textContent;
              const idEl = document.getElementById(`student-id-${sid}`);
              if (idEl) idEl.textContent = updated.studentId || idEl.textContent;
              const emailEl = document.getElementById(`student-email-${sid}`);
              if (emailEl) emailEl.textContent = updated.email || emailEl.textContent;
              const yearEl = document.getElementById(`student-year-${sid}`);
              if (yearEl) yearEl.textContent = (updated.year ? (updated.year + ' Year') : yearEl.textContent);
              const initials = document.getElementById(`student-initials-${sid}`);
              if (initials && updated.fullName) initials.textContent = (updated.fullName.split(' ').map(n=>n.charAt(0)).slice(0,2).join('').toUpperCase());
              alert('Student updated');
            } catch (err) {
              console.error('Update student error', err);
              alert('Failed to update student');
            }
          });
        }

        // populate
        const form = document.getElementById('editStudentForm');
        form.elements['id'].value = s.id;
        form.elements['fullName'].value = s.fullName || '';
        form.elements['email'].value = s.email || '';
        form.elements['course'].value = s.course || '';
        form.elements['year'].value = s.year || '';
        form.elements['section'].value = s.section || '';

        const modalEl = document.getElementById('editStudentModal');
        modalEl.classList.remove('hidden');
        // focus first input so the modal feels immediately editable
        const firstInput = modalEl.querySelector('input[name="fullName"]');
        if (firstInput) setTimeout(() => { try { firstInput.focus(); firstInput.select(); } catch(e){} }, 50);
      }
    </script>
  </div>
</body>
{{> footer }}