{{> head}}
<body class="bg-gray-50">
  <div class="min-h-screen">
    <!-- Header -->
    <header class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 flex items-center justify-center">
                <img src="/logo.png" alt="MINSU Logo" class="w-10 h-10 object-cover rounded-lg" />
              </div>
              <div>
                <h1 class="text-xl font-bold text-gray-900">CollegeTrack</h1>
                <p class="text-sm text-gray-600">Check In/Out</p>
              </div>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <div class="text-right">
              <div class="text-sm font-medium text-gray-900">{{ userName }}</div>
              <div class="text-sm text-gray-600">{{ userRole }}</div>
            </div>
            <a href="/logout" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium">Logout</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-white shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex space-x-8">
          <a href="/admin-dashboard" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Dashboard</a>
          <a href="/checkinout" class="bg-green-600 text-white px-4 py-2 rounded-md text-sm font-medium">Check In/Out</a>
          <a href="/history" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">History</a>
          <a href="/students" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Students</a>
          <a href="/calendar" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Calendar</a>
          <a href="/subjects" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Subjects</a>
        </div>
      </div>
    </nav>

    <!-- Main content layout matching attached UI -->
    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
      <div class="px-4 py-6 sm:px-0 space-y-6">

        <!-- Current Status card -->
        <div class="bg-white rounded-lg shadow-sm border border-green-100 p-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <div class="w-16 h-16 rounded-full flex items-center justify-center overflow-hidden">
                <img src="/logo.png" alt="MINSU Logo" class="w-full h-full object-cover" />
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900">{{ userName }}</h3>
                <p class="text-sm text-gray-600">{{ userRole }}</p>
                <p class="text-sm text-gray-600">Username: {{ userUsername }}</p>
              </div>
            </div>
            <div class="text-right">
              <span class="inline-block bg-gray-100 text-gray-600 px-3 py-1 rounded-full text-sm">Not Checked In</span>
            </div>
          </div>
        </div>

        <!-- Generate Student Attendance / Kiosk CTA -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6">
          <div class="text-center">
            <h3 class="text-lg font-semibold text-gray-900">Generate Student Attendance</h3>
            <p class="text-sm text-gray-500 mb-4">Open the kiosk to generate attendance for a student.</p>
            <button id="openKiosk" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-medium">Open Generate Attendance</button>
          </div>
        </div>

        <!-- Recent Activity (list placeholder) -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Activity</h3>
          <div id="recentActivity" class="space-y-4">
            <!-- Placeholder entries - ready to be filled by real attendance data -->
            <div class="bg-red-50 border border-red-100 rounded-lg p-4 flex justify-between items-start">
              <div>
                <div class="font-medium text-gray-900">00419 - John Mark Pagaran</div>
                <div class="text-sm text-gray-500">9:13 PM - Not checked out</div>
                <div class="text-sm text-gray-500">BS Information Technology</div>
              </div>
              <div class="text-right">
                <span class="text-sm text-gray-500">Absent</span>
                <div class="mt-2">
                  <button class="bg-red-100 text-red-600 px-3 py-1 rounded-full text-sm">Absent</button>
                </div>
              </div>
            </div>

            <div class="bg-red-50 border border-red-100 rounded-lg p-4 flex justify-between items-start">
              <div>
                <div class="font-medium text-gray-900">00668 - Jholand H. Galicia</div>
                <div class="text-sm text-gray-500">9:09 PM - Not checked out</div>
                <div class="text-sm text-gray-500">BS Information Technology</div>
              </div>
              <div class="text-right">
                <span class="text-sm text-gray-500">Absent</span>
                <div class="mt-2">
                  <button class="bg-red-100 text-red-600 px-3 py-1 rounded-full text-sm">Absent</button>
                </div>
              </div>
            </div>

            <!-- Additional placeholder -->
            <div class="bg-white border border-gray-100 rounded-lg p-4 flex justify-between items-start">
              <div>
                <div class="font-medium text-gray-900">Database Management</div>
                <div class="text-sm text-gray-500">8:39 PM - Not checked out</div>
                <div class="text-sm text-gray-500">CS 201 - 116</div>
              </div>
              <div class="text-right">
                <span class="text-sm text-gray-500">Absent</span>
                <div class="mt-2">
                  <button class="bg-red-100 text-red-600 px-3 py-1 rounded-full text-sm">Absent</button>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    // Navigate to generate attendance page
    document.getElementById('openKiosk')?.addEventListener('click', function() {
      window.location.href = '/generate-attendance';
    });

    // Load recent activity
    async function loadRecentActivity() {
      try {
        const res = await fetch('/api/recent-activity');
        const json = await res.json();
        const container = document.getElementById('recentActivity');
        
        if (json.data && json.data.length > 0) {
          container.innerHTML = '';
          json.data.forEach(activity => {
            const activityEl = document.createElement('div');
            let statusClass, statusButtonClass;
            
            if (activity.status === 'Present') {
              statusClass = 'bg-green-50 border-green-100';
              statusButtonClass = 'bg-green-100 text-green-600';
            } else if (activity.status === 'Late') {
              statusClass = 'bg-yellow-50 border-yellow-100';
              statusButtonClass = 'bg-yellow-100 text-yellow-600';
            } else {
              statusClass = 'bg-red-50 border-red-100';
              statusButtonClass = 'bg-red-100 text-red-600';
            }
            
            activityEl.className = `${statusClass} border rounded-lg p-4 flex justify-between items-start`;
            activityEl.innerHTML = `
              <div>
                <div class="font-medium text-gray-900">${activity.studentName}</div>
                <div class="text-sm text-gray-500">${activity.studentId} - ${activity.course}</div>
                <div class="text-sm text-gray-500">${activity.subject} • ${activity.checkIn}${activity.checkOut ? ` - ${activity.checkOut}` : ''}</div>
              </div>
              <div class="text-right">
                <span class="text-sm text-gray-500">${activity.status}</span>
                <div class="mt-2 flex space-x-2">
                  <button class="${statusButtonClass} px-3 py-1 rounded-full text-sm">${activity.status}</button>
                  ${!activity.checkOut ? `<button onclick="checkoutStudent('${activity.studentId}', '${activity.subject}')" class="bg-blue-100 text-blue-600 px-3 py-1 rounded-full text-sm hover:bg-blue-200">Check Out</button>` : ''}
                </div>
              </div>
            `;
            container.appendChild(activityEl);
          });
        }
      } catch (error) {
        console.error('Failed to load recent activity:', error);
      }
    }

    // Checkout student function
    async function checkoutStudent(studentId, subjectName) {
      try {
        const res = await fetch('/api/student-checkout', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            studentId: studentId,
            subjectName: subjectName
          })
        });
        
        const result = await res.json();
        
        if (res.ok) {
          showNotification(`Student ${result.data.studentName} checked out successfully`, 'success');
          loadRecentActivity(); // Refresh the activity list
        } else {
          showNotification(result.error || 'Checkout failed', 'error');
        }
      } catch (error) {
        console.error('Checkout error:', error);
        showNotification('Checkout failed. Please try again.', 'error');
      }
    }

    // Notification system
    function showNotification(message, type = 'success') {
      // Create notification element if it doesn't exist
      let notification = document.getElementById('notification');
      if (!notification) {
        notification = document.createElement('div');
        notification.id = 'notification';
        notification.className = 'fixed top-4 right-4 z-50 hidden';
        notification.innerHTML = `
          <div class="bg-white border border-gray-200 rounded-lg shadow-lg p-4 max-w-sm">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div id="notificationIcon" class="w-5 h-5"></div>
              </div>
              <div class="ml-3">
                <p id="notificationMessage" class="text-sm font-medium text-gray-900"></p>
              </div>
            </div>
          </div>
        `;
        document.body.appendChild(notification);
      }
      
      const icon = document.getElementById('notificationIcon');
      const messageEl = document.getElementById('notificationMessage');
      
      messageEl.textContent = message;
      
      if (type === 'success') {
        icon.innerHTML = '<svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>';
      } else if (type === 'error') {
        icon.innerHTML = '<svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>';
      }
      
      notification.classList.remove('hidden');
      setTimeout(() => {
        notification.classList.add('hidden');
      }, 3000);
    }

    // Initialize page
    document.addEventListener('DOMContentLoaded', function() {
      loadRecentActivity();
      
      // Refresh recent activity every 30 seconds
      setInterval(loadRecentActivity, 30000);
    });
  </script>
</body>
{{> footer }}