{{> head}}
<body class="bg-gray-50">
  <div class="min-h-screen">
    <!-- Header -->
    <header class="bg-white shadow-sm border-b border-gray-200">
  <div class="w-full px-4 sm:px-6 lg:px-8">
  <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 flex items-center justify-center">
                <img src="/logo.png" alt="MINSU Logo" class="w-10 h-10 object-cover rounded-lg" />
              </div>
              <div>
                <h1 class="text-xl font-bold text-gray-900">CollegeTrack</h1>
                <p class="text-sm text-gray-600">Generate Attendance</p>
              </div>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <div class="text-right">
              <div class="text-sm font-medium text-gray-900">{{ userName }}</div>
              <div class="text-sm text-gray-600">{{ userRole }}</div>
            </div>
            <a href="/logout" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium">Logout</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-white shadow-sm">
      <div class="w-full px-4 sm:px-6 lg:px-8">
        <div class="flex space-x-8">
          <a href="/admin-dashboard" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Dashboard</a>
          <a href="/checkinout" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Check In/Out</a>
          <a href="/history" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">History</a>
          <a href="/students" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Students</a>
          <a href="/calendar" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Calendar</a>
          <a href="/subjects" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">Subjects</a>
        </div>
      </div>
    </nav>

  <main class="w-full px-4 py-6 sm:px-6 lg:px-8">
      <!-- Back Button -->
      <div class="mb-6">
        <a href="/checkinout" class="inline-flex items-center text-gray-600 hover:text-gray-900">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Check In/Out
        </a>
      </div>

      <!-- Main Content -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Left: Subject Selection & Student Check-in -->
        <div class="space-y-6">
          <!-- Subject Selection -->
          <div class="bg-white rounded-lg shadow-sm border border-green-100 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Select Subject</h3>
            <div class="space-y-4">
              <div>
                <label for="subjectSelect" class="block text-sm font-medium text-gray-700 mb-2">
                  All Subjects
                </label>
                <input 
                  type="text" 
                  id="subjectSearch" 
                  class="w-full mb-2 border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                  placeholder="Search subject by name, code, day, or room..."/>
                <select id="subjectSelect" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                  <option value="">Select a subject...</option>
                </select>
                <p class="text-xs text-gray-500 mt-1">Start typing to quickly find a subject.</p>
              </div>
              <div id="selectedSubjectInfo" class="hidden bg-green-50 border border-green-200 rounded-lg p-4">
                <div class="flex items-center">
                  <div class="w-3 h-3 bg-green-500 rounded-full mr-3"></div>
                  <div>
                    <div class="font-medium text-gray-900" id="selectedSubjectName"></div>
                    <div class="text-sm text-gray-600" id="selectedSubjectTime"></div>
                    <div class="text-sm text-gray-600" id="selectedSubjectRoom"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Student Check-in Section -->
          <div id="studentCheckinSection" class="bg-white rounded-lg shadow-sm border border-green-100 p-6 hidden">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Student Check-in</h3>
            <form id="studentCheckinForm" class="space-y-4">
              <div>
                <label for="studentId" class="block text-sm font-medium text-gray-700 mb-2">
                  Student ID
                </label>
                <input 
                  type="text" 
                  id="studentId" 
                  name="studentId"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
                  placeholder="Enter Student ID"
                  required
                />
              </div>
              
              <div>
                <label for="studentPassword" class="block text-sm font-medium text-gray-700 mb-2">
                  Password
                </label>
                <div class="relative">
                  <input 
                    type="password" 
                    id="studentPassword" 
                    name="password"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
                    placeholder="Enter Password"
                    required
                  />
                  <button 
                    type="button" 
                    id="togglePassword"
                    class="absolute inset-y-0 right-0 pr-3 flex items-center"
                  >
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  </button>
                </div>
              </div>
              
              <button 
                type="submit" 
                class="w-full bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-md transition-colors duration-200"
              >
                Check In
              </button>
            </form>
          </div>
        </div>

        <!-- Right: Recent Activity -->
        <div class="bg-white rounded-lg shadow-sm border border-green-100 p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Activity</h3>
          <div id="recentActivity" class="space-y-4">
            <!-- Activity items will be loaded here -->
            <div class="text-center text-gray-500 py-8">
              <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
              <p>No recent activity</p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Notification Toast -->
  <div id="notification" class="fixed top-4 right-4 z-50 hidden">
    <div class="bg-white border border-gray-200 rounded-lg shadow-lg p-4 max-w-sm">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div id="notificationIcon" class="w-5 h-5"></div>
        </div>
        <div class="ml-3">
          <p id="notificationMessage" class="text-sm font-medium text-gray-900"></p>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Global variables
    let selectedSubject = null;
    let currentTime = new Date();

    // Notification system
    function showNotification(message, type = 'success') {
      const notification = document.getElementById('notification');
      const icon = document.getElementById('notificationIcon');
      const messageEl = document.getElementById('notificationMessage');
      
      messageEl.textContent = message;
      
      if (type === 'success') {
        icon.innerHTML = '<svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>';
      } else if (type === 'error') {
        icon.innerHTML = '<svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>';
      }
      
      notification.classList.remove('hidden');
      setTimeout(() => {
        notification.classList.add('hidden');
      }, 3000);
    }

    // Helpers
    function to12Hour(timeStr) {
      if (!timeStr) return '--:--';
      const [hStr, mStr] = timeStr.split(':');
      let h = parseInt(hStr, 10);
      const m = parseInt(mStr, 10) || 0;
      const suffix = h >= 12 ? 'pm' : 'am';
      h = h % 12;
      if (h === 0) h = 12;
      const mm = String(m).padStart(2, '0');
      return `${h}:${mm} ${suffix}`;
    }

    // Store subjects for client-side filtering
    let allSubjects = [];

    // Load all subjects
    async function loadSubjects() {
      try {
        const res = await fetch('/api/subjects');
        const json = await res.json();
        allSubjects = Array.isArray(json.data) ? json.data : [];
        renderSubjectOptions('');
      } catch (error) {
        console.error('Failed to load subjects:', error);
        showNotification('Failed to load subjects', 'error');
      }
    }

    function renderSubjectOptions(filterText) {
      const subjectSelect = document.getElementById('subjectSelect');
      subjectSelect.innerHTML = '<option value="">Select a subject...</option>';
      const q = (filterText || '').toLowerCase();
      allSubjects
        .filter(s => {
          const parts = [s.name, s.code, s.day, s.startTime, s.endTime, s.room].map(v => (v || '').toString().toLowerCase());
          return q === '' || parts.some(p => p.includes(q));
        })
        .forEach(subject => {
          const labelCode = subject.code ? ` ${subject.code}` : '';
          const labelTime = subject.startTime || subject.endTime ? ` (${to12Hour(subject.startTime) || '--:--'} - ${to12Hour(subject.endTime) || '--:--'})` : '';
          const option = document.createElement('option');
          option.value = subject.id;
          option.textContent = `${subject.name}${labelCode}${labelTime}`;
          option.dataset.subject = JSON.stringify(subject);
          subjectSelect.appendChild(option);
        });
    }

    // Handle subject selection
    document.getElementById('subjectSelect').addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];
      const studentCheckinSection = document.getElementById('studentCheckinSection');
      const selectedSubjectInfo = document.getElementById('selectedSubjectInfo');
      
      if (selectedOption.value && selectedOption.dataset.subject) {
        selectedSubject = JSON.parse(selectedOption.dataset.subject);
        
        // Show subject info
        document.getElementById('selectedSubjectName').textContent = selectedSubject.name;
        document.getElementById('selectedSubjectTime').textContent = `${to12Hour(selectedSubject.startTime)} - ${to12Hour(selectedSubject.endTime)}`;
        document.getElementById('selectedSubjectRoom').textContent = selectedSubject.room || 'No room specified';
        
        selectedSubjectInfo.classList.remove('hidden');
        studentCheckinSection.classList.remove('hidden');
      } else {
        selectedSubject = null;
        selectedSubjectInfo.classList.add('hidden');
        studentCheckinSection.classList.add('hidden');
      }
    });

    // Search filter for subjects
    document.getElementById('subjectSearch').addEventListener('input', function() {
      renderSubjectOptions(this.value);
    });

    // Password toggle functionality
    document.getElementById('togglePassword').addEventListener('click', function() {
      const passwordInput = document.getElementById('studentPassword');
      const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
      passwordInput.setAttribute('type', type);
      
      // Update icon
      const icon = this.querySelector('svg');
      if (type === 'text') {
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>';
      } else {
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>';
      }
    });

    // Handle student check-in
    document.getElementById('studentCheckinForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      if (!selectedSubject) {
        showNotification('Please select a subject first', 'error');
        return;
      }
      
      const formData = new FormData(this);
      const studentId = formData.get('studentId');
      const password = formData.get('password');
      
      try {
        const res = await fetch('/api/student-checkin', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            studentId,
            password,
            subjectId: selectedSubject.id,
            subjectName: selectedSubject.name
          })
        });
        
        const result = await res.json();
        
        if (res.ok) {
          showNotification('Attendance Recorded Successfully', 'success');
          this.reset();
          loadRecentActivity();
        } else {
          showNotification(result.error || 'Check-in failed', 'error');
        }
      } catch (error) {
        console.error('Check-in error:', error);
        showNotification('Check-in failed. Please try again.', 'error');
      }
    });

    // Load recent activity
    async function loadRecentActivity() {
      try {
        const res = await fetch('/api/recent-activity');
        const json = await res.json();
        const container = document.getElementById('recentActivity');
        
        if (json.data && json.data.length > 0) {
          container.innerHTML = '';
          json.data.forEach(activity => {
            const activityEl = document.createElement('div');
            activityEl.className = 'bg-green-50 border border-green-100 rounded-lg p-4 flex justify-between items-start';
            activityEl.innerHTML = `
              <div>
                <div class="font-medium text-gray-900">${activity.studentName}</div>
                <div class="text-sm text-gray-500">${activity.studentId} - ${activity.course}</div>
                <div class="text-sm text-gray-500">${activity.subject} • ${activity.checkIn}${activity.checkOut ? ` - ${activity.checkOut}` : ''}</div>
              </div>
              <div class="text-right">
                <div class="flex items-center space-x-2">
                  <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    ${activity.status}
                  </span>
                  ${!activity.checkOut ? `<button onclick="checkoutStudent('${activity.studentId}', '${activity.subject}')" class="bg-blue-100 text-blue-600 px-2 py-1 rounded-full text-xs hover:bg-blue-200">Check Out</button>` : ''}
                </div>
              </div>
            `;
            container.appendChild(activityEl);
          });
        } else {
          container.innerHTML = `
            <div class="text-center text-gray-500 py-8">
              <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
              <p>No recent activity</p>
            </div>
          `;
        }
      } catch (error) {
        console.error('Failed to load recent activity:', error);
      }
    }

    // Checkout student function
    async function checkoutStudent(studentId, subjectName) {
      try {
        const res = await fetch('/api/student-checkout', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            studentId: studentId,
            subjectName: subjectName
          })
        });
        
        const result = await res.json();
        
        if (res.ok) {
          showNotification(`Student ${result.data.studentName} checked out successfully`, 'success');
          loadRecentActivity(); // Refresh the activity list
        } else {
          showNotification(result.error || 'Checkout failed', 'error');
        }
      } catch (error) {
        console.error('Checkout error:', error);
        showNotification('Checkout failed. Please try again.', 'error');
      }
    }

    // Initialize page
    document.addEventListener('DOMContentLoaded', function() {
      loadSubjects();
      loadRecentActivity();
      
      // Optional: Refresh subjects periodically
      setInterval(loadSubjects, 60000);
      
      // Refresh recent activity every 30 seconds
      setInterval(loadRecentActivity, 30000);
    });
  </script>
</body>
{{> footer }}
