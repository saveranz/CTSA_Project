{{> head}}
<body class="bg-gray-50">
  <div class="min-h-screen">
    <!-- Header -->
    <header class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 flex items-center justify-center">
                <img src="/logo.png" alt="MINSU Logo" class="w-10 h-10 object-cover rounded-lg" />
              </div>
              <div>
                <h1 class="text-xl font-bold text-gray-900">CollegeTrack</h1>
                <p class="text-sm text-gray-600">Calendar</p>
              </div>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <div class="text-right">
              <div class="text-sm font-medium text-gray-900">{{ userName }}</div>
              <div class="text-sm text-gray-600">{{ userRole }}</div>
            </div>
            <a href="/logout" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium">Logout</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Navigation Bar -->
    <nav class="bg-white shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex space-x-8">
          <a href="/student-dashboard" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">
            Dashboard
          </a>
          <a href="/student/checkinout" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">
            Check In/Out
          </a>
          <a href="/student/calendar" class="bg-green-600 text-white px-4 py-2 rounded-md text-sm font-medium">
            Calendar
          </a>
          <a href="/student/subjects" class="text-gray-700 hover:text-gray-900 px-4 py-2 text-sm font-medium">
            Subjects
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
      <div class="px-4 py-6 sm:px-0">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Attendance Calendar -->
          <div class="col-span-2 bg-white rounded-lg shadow-sm border border-gray-100 p-6">
            <div class="mb-6">
              <h3 class="text-xl font-bold text-gray-900">Attendance Calendar</h3>
              <p class="text-sm text-gray-600">Monthly view of attendance patterns</p>
            </div>
            
            <!-- Month Navigation -->
            <div class="flex items-center justify-center mb-6">
              <button class="p-2 rounded-full hover:bg-gray-100" onclick="changeMonth(-1)">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
              </button>
              <h4 class="text-lg font-semibold text-gray-900 mx-4" id="currentMonth">October 2025</h4>
              <button class="p-2 rounded-full hover:bg-gray-100" onclick="changeMonth(1)">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </div>

            <!-- Calendar Grid -->
            <div class="grid grid-cols-7 gap-2 mb-4">
              <div class="text-center text-sm font-medium text-gray-500 py-2">Sun</div>
              <div class="text-center text-sm font-medium text-gray-500 py-2">Mon</div>
              <div class="text-center text-sm font-medium text-gray-500 py-2">Tue</div>
              <div class="text-center text-sm font-medium text-gray-500 py-2">Wed</div>
              <div class="text-center text-sm font-medium text-gray-500 py-2">Thu</div>
              <div class="text-center text-sm font-medium text-gray-500 py-2">Fri</div>
              <div class="text-center text-sm font-medium text-gray-500 py-2">Sat</div>
            </div>

            <div id="calendarGrid" class="grid grid-cols-7 gap-2">
              <!-- Calendar days will be generated by JavaScript -->
            </div>
          </div>

          <!-- Select a Date and Legend -->
          <div class="space-y-6">
            <!-- Select a Date Panel -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Select a Date</h3>
              <p class="text-sm text-gray-600 mb-4">Click on a calendar date to view details</p>
              
              <div id="dateDetails" class="bg-gray-50 rounded-lg h-48 flex items-center justify-center text-gray-400">
                <div class="text-center">
                  <svg class="w-12 h-12 mx-auto mb-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <p class="text-sm">Select a date to view attendance details</p>
                </div>
              </div>
            </div>

            <!-- Legend -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-4">Legend</h3>
              <div class="space-y-3">
                <div class="flex items-center">
                  <div class="w-4 h-4 bg-green-500 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">Excellent (90%+)</span>
                </div>
                <div class="flex items-center">
                  <div class="w-4 h-4 bg-green-300 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">Good (80-89%)</span>
                </div>
                <div class="flex items-center">
                  <div class="w-4 h-4 bg-yellow-400 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">Average (70-79%)</span>
                </div>
                <div class="flex items-center">
                  <div class="w-4 h-4 bg-red-400 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">Poor (&lt;70%)</span>
                </div>
                <div class="flex items-center">
                  <div class="w-4 h-4 bg-gray-300 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">No Data</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      let currentDate = new Date();
      
      function updateCalendar() {
        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();
        const monthNames = ["January", "February", "March", "April", "May", "June",
          "July", "August", "September", "October", "November", "December"];
        
        document.getElementById('currentMonth').textContent = `${monthNames[month]} ${year}`;
        
        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);
        const daysInMonth = lastDay.getDate();
        const startingDayOfWeek = firstDay.getDay();
        
        const calendarGrid = document.getElementById('calendarGrid');
        calendarGrid.innerHTML = '';
        
        // Add empty cells for days before the first day of the month
        for (let i = 0; i < startingDayOfWeek; i++) {
          const emptyCell = document.createElement('div');
          emptyCell.className = 'h-20 rounded-lg';
          calendarGrid.appendChild(emptyCell);
        }
        
        // Add days of the month
        for (let day = 1; day <= daysInMonth; day++) {
          const dayCell = document.createElement('div');
          dayCell.className = 'h-20 rounded-lg border border-gray-200 p-2 cursor-pointer hover:bg-gray-50';
          dayCell.onclick = () => selectDate(day, month, year);
          
          // Add day number
          const dayNumber = document.createElement('div');
          dayNumber.className = 'text-sm font-medium text-gray-900';
          dayNumber.textContent = day;
          dayCell.appendChild(dayNumber);
          
          // Add attendance indicator (example: day 18 has excellent attendance)
          if (day === 18) {
            dayCell.className += ' bg-green-100 border-green-300';
            const indicator = document.createElement('div');
            indicator.className = 'text-xs text-green-700 mt-1';
            indicator.textContent = '1 log';
            dayCell.appendChild(indicator);
          } else {
            // Add a dash for other days
            const dash = document.createElement('div');
            dash.className = 'text-xs text-gray-400 mt-1';
            dash.textContent = '-';
            dayCell.appendChild(dash);
          }
          
          calendarGrid.appendChild(dayCell);
        }
      }
      
      function changeMonth(direction) {
        currentDate.setMonth(currentDate.getMonth() + direction);
        updateCalendar();
      }
      
      async function selectDate(day, month, year) {
        const dateDetails = document.getElementById('dateDetails');
        const selected = new Date(year, month, day);
        const y = selected.getFullYear();
        const m = String(selected.getMonth() + 1).padStart(2, '0');
        const d = String(selected.getDate()).padStart(2, '0');
        const iso = `${y}-${m}-${d}`;

        dateDetails.innerHTML = `<div class="text-sm text-gray-600">Loading...</div>`;

        try {
          const res = await fetch(`/api/attendance-summary?date=${iso}`);
          if (!res.ok) throw new Error('Failed to load');
          const data = await res.json();
          const counts = data.counts || { present: 0, late: 0, absent: 0 };
          const total = data.total || 0;
          const prettyDate = `${day} ${new Date(year, month).toLocaleDateString('en-US', { month: 'long' })} ${year}`;
          dateDetails.innerHTML = `
            <div class="text-center">
              <div class="text-lg font-semibold text-gray-900">${prettyDate}</div>
              <div class="text-sm text-gray-600 mb-3">Total Records: ${total}</div>
              <div class="grid grid-cols-3 gap-2">
                <div class="bg-green-50 border border-green-200 rounded p-2">
                  <div class="text-xs text-gray-600">Present</div>
                  <div class="text-base font-semibold text-green-700">${counts.present}</div>
                </div>
                <div class="bg-yellow-50 border border-yellow-200 rounded p-2">
                  <div class="text-xs text-gray-600">Late</div>
                  <div class="text-base font-semibold text-yellow-700">${counts.late}</div>
                </div>
                <div class="bg-red-50 border border-red-200 rounded p-2">
                  <div class="text-xs text-gray-600">Absent</div>
                  <div class="text-base font-semibold text-red-700">${counts.absent}</div>
                </div>
              </div>
            </div>
          `;
        } catch (e) {
          dateDetails.innerHTML = `<div class="text-sm text-red-600">Failed to load attendance summary.</div>`;
        }
      }
      
      // Initialize calendar
      updateCalendar();
    </script>
  </div>
</body>
{{> footer }}